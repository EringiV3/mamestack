{
  "name": "未ログインは 401、登録して入ると 200",
  "steps": [
    { "type": "assertStatus", "path": "/api/me", "status": 401 },
    { "type": "goto", "path": "/signup" },
    { "type": "fill", "selector": "input[name=email]", "value": "user@example.com" },
    { "type": "fill", "selector": "input[name=password]", "value": "example-password" },
    { "type": "click", "selector": "button[type=submit]" },
    { "type": "goto", "path": "/login" },
    { "type": "fill", "selector": "input[name=email]", "value": "user@example.com" },
    { "type": "fill", "selector": "input[name=password]", "value": "example-password" },
    { "type": "click", "selector": "button[type=submit]" },
    { "type": "assertStatus", "path": "/api/me", "status": 200 }
  ]
}
